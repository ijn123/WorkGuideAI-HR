    "@langchain/google-genai": "^2.3.2",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.3",
    "@qdrant/js-client-rest": "^1.19.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.2",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "auth:provision": "node --env-file-if-exists=.env --require ts-node/register scripts/provision-password.mjs",
