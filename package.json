{
  "name": "workguide-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Учебный HR RAG-проект: структурный каркас, реализация ещё не добавлена",
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/google": "^0.2.6",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.2",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "demo:create-employees": "node --env-file-if-exists=.env scripts/create-demo-employees.mjs",
    "test:demo-employees": "node --test test/database/create-demo-employees.test.mjs",
    "auth:provision": "node --env-file-if-exists=.env --require ts-node/register scripts/provision-password.mjs",
    "test:auth": "npm run build && node --test test/auth/auth.unit.test.cjs test/auth/auth.http.test.cjs",
    "test:database": "npm run build && node --test test/database/database.unit.test.cjs",
    "test:validation": "npm run build && node --test test/validation/request-dto.unit.test.cjs",
    "test": "npm run test:validation && npm run test:auth && npm run test:database"
  }
}
