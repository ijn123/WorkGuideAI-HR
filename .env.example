PORT=3000
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=workguide_hr

# Set a randomly generated secret with at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=workguide_ai
DB_USER=workguide_app
DB_PASSWORD=replace_with_reader_password
DB_MIGRATION_USER=workguide
DB_MIGRATION_PASSWORD=replace_with_admin_password

POSTGRES_PASSWORD=replace_with_your_password
# false for local, true for production
DB_SSL=false

INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=200

INGESTION_MAX_FILE_SIZE_MB=10

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.65
RAG_MAX_CONTEXT_CHARS=12000
